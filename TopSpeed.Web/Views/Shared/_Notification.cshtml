@{
    var successMsg = TempData["success"] ?? TempData["Success"];
    var warningMsg = TempData["warning"] ?? TempData["Warning"];
    var errorMsg = TempData["error"] ?? TempData["Error"];
}

<script type="text/javascript">
    toastr.options = {
        "closeButton": true,
        "debug": false,
        "newestOnTop": true,
        "progressBar": true,
        "positionClass": "toast-top-right",
        "preventDuplicates": true,
        "showDuration": "300",
        "hideDuration": "800",
        "timeOut": "4000",
        "extendedTimeOut": "1000",
        "showEasing": "swing",
        "hideEasing": "linear",
        "showMethod": "fadeIn",
        "hideMethod": "fadeOut"
    };

    @if (successMsg != null)
    {
        <text>toastr.success('@Html.Raw(successMsg)');</text>
    }

    @if (warningMsg != null)
    {
        <text>toastr.warning('@Html.Raw(warningMsg)');</text>
    }

    @if (errorMsg != null)
    {
        <text>toastr.error('@Html.Raw(errorMsg)');</text>
    }
</script>
