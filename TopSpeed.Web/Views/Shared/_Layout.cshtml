<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TopSpeed Automobile</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- DataTables & Toastr -->
    <link rel="stylesheet" href="https://cdn.datatables.net/2.1.8/css/dataTables.dataTables.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    
    <!-- Custom Theme Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom">
            <div class="container">
                <a class="navbar-brand brand-emblem" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="icon-box">
                        <i class="bi bi-speedometer2"></i>
                    </span>
                    <span>TopSpeed <span class="text-gradient">Automobile</span></span>
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" 
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Brand" asp-action="Index">
                                <i class="bi bi-shield-check"></i> Brands
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Vehicle" asp-action="Index">
                                <i class="bi bi-car-front"></i> Vehicles
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Vehicle" asp-action="Compare">
                                <i class="bi bi-shuffle text-warning"></i> Spec Battle
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-area="" asp-controller="Garage" asp-action="Index">
                                    <i class="bi bi-heart-fill text-danger"></i> My Garage
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-area="" asp-controller="Admin" asp-action="Dashboard">
                                    <i class="bi bi-speedometer text-danger"></i> Admin
                                </a>
                            </li>
                        }
                    </ul>
                    
                    <div class="d-flex align-items-center">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4 flex-grow-1">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-custom">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-md-5">
                    <div class="brand-emblem mb-3">
                        <span class="icon-box">
                            <i class="bi bi-speedometer2"></i>
                        </span>
                        <span>TopSpeed <span class="text-gradient">Auto</span></span>
                    </div>
                    <p class="text-muted pe-md-4">
                        The ultimate automotive brand directory and fleet management hub. Engineered for high performance, precision tracking, and rich automotive heritage.
                    </p>
                </div>
                <div class="col-md-3">
                    <h6 class="text-white text-uppercase mb-3 fw-bold">Explore</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a asp-controller="Home" asp-action="Index"><i class="bi bi-chevron-right me-1 text-danger"></i> Home Showcase</a></li>
                        <li class="mb-2"><a asp-controller="Brand" asp-action="Index"><i class="bi bi-chevron-right me-1 text-danger"></i> Brand Catalog</a></li>
                        <li class="mb-2"><a asp-controller="Brand" asp-action="Create"><i class="bi bi-chevron-right me-1 text-danger"></i> Add New Brand</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Privacy"><i class="bi bi-chevron-right me-1 text-danger"></i> Privacy Policy</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="text-white text-uppercase mb-3 fw-bold">Platform Status</h6>
                    <div class="d-flex align-items-center gap-2 mb-2 text-muted">
                        <span class="badge bg-success rounded-pill px-2 py-1"><i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i> System Live</span>
                        <span>ASP.NET Core 8.0</span>
                    </div>
                    <p class="small text-muted mb-0">Secure SQL Server connection with Identity Role Management enabled.</p>
                </div>
            </div>
            
            <div class="pt-3 border-top border-secondary border-opacity-25 d-flex flex-wrap justify-content-between align-items-center text-muted small">
                <div>
                    &copy; @DateTime.Now.Year TopSpeed Automobile. All rights reserved.
                </div>
                <div>
                    Built with <span class="text-danger">&hearts;</span> for High Performance.
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://cdn.datatables.net/2.1.8/js/dataTables.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <partial name="_Notification" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
