@model Vehicle
@{
    ViewData["Title"] = "Delete Vehicle - " + Model.Name;
}

<div class="mb-4 pb-2 border-bottom border-secondary border-opacity-25">
    <a asp-controller="Vehicle" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-glass mb-2">
        <i class="bi bi-arrow-left"></i> Back to Vehicle Details
    </a>
    <h2 class="fw-bold mb-1 text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i> Delete Vehicle Confirmation</h2>
    <p class="text-muted small mb-0">Confirm deletion of this vehicle from the showroom catalog.</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="glass-card border-danger border-opacity-50" style="box-shadow: 0 0 35px -5px rgba(239, 68, 68, 0.25);">
            <div class="card-header bg-danger bg-opacity-10 border-danger border-opacity-25 d-flex align-items-center gap-2 text-danger">
                <i class="bi bi-shield-slash-fill fs-5"></i>
                <span class="fw-bold">Permanent Removal Warning</span>
            </div>
            <div class="card-body p-4">
                <p class="text-muted mb-4">
                    You are about to permanently delete <strong>@Model.Brand?.Name @Model.Name</strong> from the showroom catalog. All saved bookmarks and specs will be deleted.
                </p>

                <div class="row align-items-center g-4 p-3 rounded-3 mb-4" style="background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-subtle);">
                    <div class="col-sm-5 text-center">
                        <div style="height: 120px; border-radius: 8px; overflow: hidden; background: #000;">
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <img src="@Model.ImageUrl" alt="@Model.Name" class="w-100 h-100" style="object-fit: cover;" 
                                     onerror="this.src='/images/vehicles/placeholder_car.png';" />
                            }
                            else
                            {
                                <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted"><i class="bi bi-car-front" style="font-size: 2.5rem;"></i></div>
                            }
                        </div>
                    </div>
                    <div class="col-sm-7">
                        <div class="small text-danger fw-bold text-uppercase">@Model.Brand?.Name</div>
                        <h4 class="text-white fw-bold mb-1">@Model.Name</h4>
                        <div class="text-muted small mb-1">Specs: <span class="text-white">@Model.Horsepower HP &bull; @Model.TopSpeed km/h</span></div>
                        <div class="text-muted small">Price: <span class="text-white fw-semibold">$@Model.Price.ToString("N0")</span></div>
                    </div>
                </div>

                <form method="post">
                    <input asp-for="Id" type="hidden" />
                    
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary border-opacity-25">
                        <a asp-controller="Vehicle" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-speed-outline">
                            <i class="bi bi-arrow-left"></i> Cancel & Keep
                        </a>
                        <button type="submit" class="btn btn-danger-glass btn-lg px-4" style="background: var(--speed-red); color: white;">
                            <i class="bi bi-trash3-fill me-1"></i> Confirm Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
