@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Areas/Identity/Pages/_AuthLayout.cshtml";
}

<form method="post">
    <div class="text-center mb-4">
        <h3 class="fw-bold text-white mb-1">Reset Password</h3>
        <p class="text-muted small">Enter your account email to receive a reset link.</p>
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

    <div class="form-floating mb-4">
        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
        <label asp-for="Input.Email">Email Address</label>
        <span asp-validation-for="Input.Email" class="text-danger small"></span>
    </div>

    <button type="submit" class="w-100 btn btn-speed btn-lg mb-3">
        <i class="bi bi-envelope-arrow-up me-1"></i> Send Reset Link
    </button>

    <div class="text-center">
        <a asp-page="./Login" class="text-muted small">
            <i class="bi bi-arrow-left me-1"></i> Back to Sign In
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
