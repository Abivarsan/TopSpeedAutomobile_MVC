@page
@model ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Email Sent";
    Layout = "~/Areas/Identity/Pages/_AuthLayout.cshtml";
}

<div class="text-center py-3">
    <div class="feature-icon-wrapper mx-auto mb-3" style="width: 65px; height: 65px; font-size: 2rem;">
        <i class="bi bi-envelope-check"></i>
    </div>
    <h3 class="fw-bold text-white mb-2">Check Your Email</h3>
    <p class="text-muted small mb-4">
        A password reset link has been dispatched. Please check your inbox and follow the instructions to set a new password.
    </p>
    <a asp-page="./Login" class="btn btn-speed-outline">
        <i class="bi bi-arrow-left me-1"></i> Return to Sign In
    </a>
</div>
