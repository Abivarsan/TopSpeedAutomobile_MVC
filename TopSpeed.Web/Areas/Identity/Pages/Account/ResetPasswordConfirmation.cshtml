@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Password Reset Succeeded";
    Layout = "~/Areas/Identity/Pages/_AuthLayout.cshtml";
}

<div class="text-center py-3">
    <div class="feature-icon-wrapper mx-auto mb-3" style="width: 65px; height: 65px; font-size: 2rem;">
        <i class="bi bi-shield-fill-check"></i>
    </div>
    <h3 class="fw-bold text-white mb-2">Password Reset</h3>
    <p class="text-muted small mb-4">
        Your password has been successfully updated. You can now log into your account with your new credentials.
    </p>
    <a asp-page="./Login" class="btn btn-speed">
        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In Now
    </a>
</div>
