@page
@model LoginModel

@{
    ViewData["Title"] = "Sign In";
    Layout = "~/Areas/Identity/Pages/_AuthLayout.cshtml";
}

<form id="account" method="post">
    <div class="text-center mb-4">
        <h3 class="fw-bold text-white mb-1">Welcome Back</h3>
        <p class="text-muted small">Enter your credentials to access the catalog.</p>
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

    <div class="form-floating mb-3">
        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
        <label asp-for="Input.Email">Email Address</label>
        <span asp-validation-for="Input.Email" class="text-danger small"></span>
    </div>

    <div class="form-floating mb-3">
        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Password" />
        <label asp-for="Input.Password">Password</label>
        <span asp-validation-for="Input.Password" class="text-danger small"></span>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="form-check">
            <input class="form-check-input" asp-for="Input.RememberMe" id="rememberMeCheck" />
            <label class="form-check-label text-muted small" for="rememberMeCheck">
                Remember me
            </label>
        </div>
        <a id="forgot-password" asp-page="./ForgotPassword" class="small text-danger">
            Forgot password?
        </a>
    </div>

    <button id="login-submit" type="submit" class="w-100 btn btn-speed btn-lg mb-3">
        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
    </button>

    <div class="text-center text-muted small">
        Don't have an account? 
        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-danger fw-semibold">
            Create an account
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
